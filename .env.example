# Local development environment for every service in this monorepo. Copy this
# file to `.env` at the repo root and fill in real values — `.env` is
# gitignored. Production does not use this file: each service sets
# `ignoreEnvFile` when NODE_ENV=production and gets its env injected directly
# into its container instead. The per-service split was tried and dropped —
# it just forced values like JWT_SECRET and REDIS_URL to be duplicated across
# services and kept in sync by hand.
#
# Deployment config (separate, unrelated): deploy/gcp/.env.example

NODE_ENV=development

# ---- core (apps/core) ----

# Postgres (Supabase). One Supabase project per service: core, products,
# transactions, reports. Each service needs two connection strings:
#   <SERVICE>_DATABASE_URL - pooled (Supavisor), port 6543, used at runtime
#   <SERVICE>_DIRECT_URL   - direct, port 5432, used ONLY by Prisma Migrate
# Why both: Supavisor's transaction mode can hand a different backend
# connection to each transaction, which breaks the session-scoped advisory
# locks Prisma Migrate takes, so migrations must run on the direct connection.
CORE_HOST=0.0.0.0
CORE_TCP_PORT=4001
CORE_DATABASE_URL=postgresql://core_svc:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
CORE_DIRECT_URL=postgresql://core_svc:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
CORE_DATABASE_POOL_MAX=5

# ---- shared across services ----
# Later tasks add their own services' variables here as those services land;
# do not invent entries for services that don't exist yet.

# Redis (Upstash), addressed over TCP via a rediss:// URL. There is no local
# Redis container — every environment, including local dev, talks to Upstash.
REDIS_URL=rediss://default:<password>@<your-redis-endpoint>.upstash.io:6379

# Signs and verifies auth tokens. Shared on purpose: core (which signs) and
# the gateway (which verifies) must never drift out of sync — a mismatch
# here fails as a confusing 401, not an obvious config error.
JWT_SECRET=replace-me-with-at-least-32-characters-of-entropy
JWT_EXPIRES_IN_SECONDS=3600

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# Optional. Defaults to "debug" outside production, "info" in production.
# LOG_LEVEL=debug
