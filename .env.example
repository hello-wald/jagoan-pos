# One .env for the whole repo. Copy to .env and fill in.
# JWT_SECRET and REDIS_URL must be identical across services, which is why
# there is no per-service .env.
NODE_ENV=development

# ---- api-gateway ----
GATEWAY_PORT=3000

# ---- core ----
CORE_HOST=0.0.0.0
CORE_TCP_PORT=4001
# Pooled (Supavisor, 6543) at runtime.
CORE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Direct (5432) for Prisma Migrate only.
CORE_DIRECT_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
CORE_DATABASE_POOL_MAX=5

# ---- products ----
PRODUCTS_HOST=0.0.0.0
PRODUCTS_TCP_PORT=4002
PRODUCTS_DATABASE_URL=postgresql://postgres.<products-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
PRODUCTS_DIRECT_URL=postgresql://postgres:<password>@db.<products-ref>.supabase.co:5432/postgres?sslmode=require
PRODUCTS_DATABASE_POOL_MAX=5

# ---- transactions ----
TRANSACTIONS_HOST=0.0.0.0
TRANSACTIONS_TCP_PORT=4003
TRANSACTIONS_DATABASE_URL=postgresql://postgres.<transactions-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Direct (5432) for Prisma Migrate only.
TRANSACTIONS_DIRECT_URL=postgresql://postgres:<password>@db.<transactions-ref>.supabase.co:5432/postgres?sslmode=require
TRANSACTIONS_DATABASE_POOL_MAX=5
# Deadline on the catalog lookup during checkout.
PRODUCTS_RPC_TIMEOUT_MS=3000

# ---- outbox-relay ----
RABBITMQ_URL=amqps://<user>:<password>@<host>.cloudamqp.com/<vhost>
OUTBOX_DATABASE_POOL_MAX=2
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_MAX_BACKOFF_MS=60000

# ---- shared ----
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
JWT_SECRET=replace-me-with-at-least-32-characters-of-entropy
JWT_EXPIRES_IN_SECONDS=3600

# fatal | error | warn | info | debug | trace
# LOG_LEVEL=debug
