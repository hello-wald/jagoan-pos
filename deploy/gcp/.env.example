# Artifact Registry images produced by CI. Do not commit deploy/gcp/.env.
API_GATEWAY_IMAGE=asia-southeast2-docker.pkg.dev/PROJECT_ID/jagoan-pos/api-gateway:COMMIT_SHA
CORE_IMAGE=asia-southeast2-docker.pkg.dev/PROJECT_ID/jagoan-pos/core:COMMIT_SHA
PRODUCTS_IMAGE=asia-southeast2-docker.pkg.dev/PROJECT_ID/jagoan-pos/products:COMMIT_SHA

# Public API domain. Its DNS A record must point to the GCE VM static IP.
API_DOMAIN=api.example.com
CADDY_EMAIL=ops@example.com

# Pooled (Supavisor, 6543) at runtime; direct (5432) for Prisma Migrate in CI.
CORE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
CORE_DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
CORE_DATABASE_POOL_MAX=5

# Products owns a separate Supabase project/database.
PRODUCTS_DATABASE_URL=postgresql://postgres.PRODUCTS_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
PRODUCTS_DIRECT_URL=postgresql://postgres:PASSWORD@db.PRODUCTS_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
PRODUCTS_DATABASE_POOL_MAX=5

REDIS_URL=rediss://default:PASSWORD@ENDPOINT.upstash.io:6379

JWT_SECRET=replace-with-at-least-32-characters-of-entropy
JWT_EXPIRES_IN_SECONDS=3600

LOG_LEVEL=info
