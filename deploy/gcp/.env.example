# Artifact Registry images produced by CI. Do not commit deploy/gcp/.env.
API_GATEWAY_IMAGE=asia-southeast2-docker.pkg.dev/PROJECT_ID/jagoan-pos/api-gateway:COMMIT_SHA
CORE_IMAGE=asia-southeast2-docker.pkg.dev/PROJECT_ID/jagoan-pos/core-service:COMMIT_SHA

# Public API domain. Its DNS A record must point to the GCE VM static IP.
API_DOMAIN=api.example.com
CADDY_EMAIL=ops@example.com

# Supabase pooled runtime URL; use a direct URL only for Prisma migrations in CI.
CORE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

JWT_SECRET=replace-with-a-random-secret-of-at-least-16-characters
JWT_EXPIRES_IN=7d

UPSTASH_REDIS_REST_URL=https://YOUR_REDIS_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

RABBITMQ_USER=jagoan
RABBITMQ_PASSWORD=replace-with-a-long-random-password
