generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Administrator-managed catalog taxonomy. Categories are never hard-deleted:
/// products keep pointing at them, so deactivation is the only way to retire one.
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@index([isActive, name])
  @@map("categories")
}

model Product {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(150)
  sku        String    @unique @db.VarChar(64)
  categoryId String?   @map("category_id") @db.Uuid
  price      Int
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]

  @@index([isActive, name])
  @@index([categoryId, name])
  @@map("products")
}

enum ProductImageStatus {
  PENDING
  READY
}

model ProductImage {
  id          String             @id @default(uuid()) @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  storagePath String             @unique @map("storage_path") @db.VarChar(500)
  contentType String             @map("content_type") @db.VarChar(100)
  sizeBytes   Int                @map("size_bytes")
  sortOrder   Int                @default(0) @map("sort_order")
  status      ProductImageStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, status, sortOrder])
  @@map("product_images")
}
