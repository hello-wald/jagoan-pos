{
  "name": "jagoan-pos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@jagoan-pos/contracts --workspace=@jagoan-pos/shared --workspace=@jagoan-pos/redis",
    "build": "npm run build:packages && npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@jagoan-pos/core --workspace=@jagoan-pos/products --workspace=@jagoan-pos/transactions",
    "setup": "npm run prisma:generate && npm run build:packages",
    "dev": "npm run build:packages && concurrently --names gateway,core,products,transact,outbox,reports,analytics --prefix-colors cyan,green,yellow,magenta,blue,white,gray \"npm:dev:gateway\" \"npm:dev:core\" \"npm:dev:products\" \"npm:dev:transactions\" \"npm:dev:outbox\" \"npm:dev:reports\" \"npm:dev:analytics\"",

    "dev:gateway": "npm run start:dev --workspace=@jagoan-pos/api-gateway",
    "dev:core": "npm run start:dev --workspace=@jagoan-pos/core",
    "dev:products": "npm run start:dev --workspace=@jagoan-pos/products",
    "dev:transactions": "npm run start:dev --workspace=@jagoan-pos/transactions",
    "dev:outbox": "npm run start:dev --workspace=@jagoan-pos/outbox-relay",
    "dev:reports": "npm run start:dev --workspace=@jagoan-pos/reports",
    "dev:analytics": "npm run start:dev --workspace=@jagoan-pos/analytics",
    "dev:web": "npm run dev --workspace=@jagoan-pos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,css}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "concurrently": "10.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-wald/jagoan-pos.git"
  }
}
